{
  "name": "@borrowdale/core",
  "version": "0.0.0",
  "description": "Deterministic hand-drawn shapes for SVG and canvas.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@borrowdale/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./math": {
      "@borrowdale/source": "./src/math.ts",
      "types": "./dist/math.d.ts",
      "default": "./dist/math.js"
    },
    "./show": {
      "@borrowdale/source": "./src/show.ts",
      "types": "./dist/show.d.ts",
      "default": "./dist/show.js"
    }
  },
  "files": [
    "dist",
    "!dist/*.tsbuildinfo",
    "src",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "prepack": "tsc -b"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/borrowdale/borrowdale.git",
    "directory": "packages/core"
  },
  "keywords": [
    "hand-drawn",
    "sketch",
    "rough",
    "svg",
    "canvas"
  ],
  "publishConfig": {
    "access": "public"
  }
}
