{
  "name": "borrowdale-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json && tsc -p apps/site/tsconfig.json",
    "test": "vitest run",
    "example": "node apps/examples/core-and-fills.mjs",
    "example:text": "node apps/examples/text.mjs",
    "example:charts": "node apps/examples/charts.mjs",
    "goldens": "npm run build && node scripts/record-goldens.mjs",
    "fonts": "node scripts/generate-font.mjs",
    "site": "npm run dev --workspace @borrowdale/site",
    "site:build": "npm run build --workspace @borrowdale/site",
    "lockfile": "npm install --package-lock-only --ignore-scripts",
    "version-packages": "changeset version && npm run lockfile"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "happy-dom": "^21.0.4",
    "opentype.js": "2.0.0",
    "playwright-core": "1.61.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wawoff2": "2.0.1"
  },
  "engines": {
    "node": ">=24"
  }
}
